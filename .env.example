FLASK_DEBUG=true

# --- Database ---
DATABASE_NAME=hackathon_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Connection pool (see app/database.py). max_connections is PER worker
# process: keep instances x workers x max_connections below Postgres' own
# max_connections setting.
DB_MAX_CONNECTIONS=8
DB_STALE_TIMEOUT=300

# --- Cache ---
# Leave REDIS_URL unset to fall back to an in-process cache (fine for local
# dev and tests). Required for the multi-instance Docker setup, where both
# app containers must share one cache.
# REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300

# --- Observability / alerting (Incident Response) ---
# Discord or Slack incoming webhook — used by health-watch and alertmanager bridge
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...
# GRAFANA_ADMIN_PASSWORD=change-me

# --- Server (Docker only) ---
GUNICORN_WORKERS=4
GUNICORN_THREADS=8
