      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "sum(rate(flask_http_request_total{status=~\"5..\"}[2m])) / clamp_min(sum(rate(flask_http_request_total[2m])), 0.001)",
